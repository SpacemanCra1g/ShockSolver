#include "../include/DomainClass.hpp"

#define PLUS 1.0
#define MINUS -1.0

double Sign(double M) { return (M >= 0.0) ? 1.0 : -1.0; }

double MachSplit(double M, int Val) {
  double Beta = 3.0 / 8.0;
  if (std::fabs(M) >= 1.0) {
    return 0.5 * (M + Val * std::fabs(M));
  } else {
    return Val * 0.5 * (M + Val * 1.0) * (M + Val * 1.0) +
           Val * Beta * (M * M - 1.0) * (M * M - 1.0);
  }
}

double SplitPres(double M, int Val) {
  double Alpha = 1.0 / 16.0;
  if (std::fabs(M) >= 1.0) {
    return 0.5 * (1.0 + Val * Sign(M));
  } else {
    return 0.25 * (M + Val * 1.0) * (M + Val * 1.0) * (2.0 - Val * M) +
           Val * Alpha * M * (M * M - 1.0) * (M * M - 1.0);
  }
}

void Domain::Ausm(int Start, int Stop) {
  double CritAL, CritAR, HL, HR, UL, UR, RhoL, RhoR, PL, PR, aL2, aR2, aTildeL,
      aTildeR, SplitA, SplitMach, MachL, MachR, SplitMachL, SplitMachR;

  Find_Cs(FluxWalls_Prims[LEFT], RS_CsL, Start, Stop + 1);
  Find_Cs(FluxWalls_Prims[RIGHT], RS_CsR, Start, Stop);

  for (int i = Start; i < Stop; ++i) {
    aL2 = RS_CsR[i];
    aR2 = RS_CsL[i + 1];

    UL = FluxWalls_Prims[RIGHT][Tidx(VELX, i)];
    UR = FluxWalls_Prims[LEFT][Tidx(VELX, i + 1)];

    PL = FluxWalls_Prims[RIGHT][Tidx(PRES, i)];
    PR = FluxWalls_Prims[LEFT][Tidx(PRES, i + 1)];

    RhoL = FluxWalls_Prims[RIGHT][Tidx(DENS, i)];
    RhoR = FluxWalls_Prims[LEFT][Tidx(DENS, i + 1)];

    HL = aL2 / (GAMMA - 1.0) + 0.5 * UL * UL;
    HR = aR2 / (GAMMA - 1.0) + 0.5 * UR * UR;

    CritAL = std::sqrt(2.0 * (GAMMA - 1.0) * HL / (GAMMA + 1.0));

    CritAR = std::sqrt(2.0 * (GAMMA - 1.0) * HR / (GAMMA + 1.0));

    aTildeL = CritAL * CritAL / std::fmax(CritAL, std::abs(UL));
    aTildeR = CritAR * CritAR / std::fmax(CritAR, std::abs(UR));

    // SplitA = .5 * (std::sqrt(aL2) + std::sqrt(aR2));
    SplitA = std::fmin(aTildeL, aTildeR);

    MachL = UL / SplitA;
    MachR = UR / SplitA;

    SplitMach = MachSplit(MachL, PLUS) + MachSplit(MachR, MINUS);

    SplitMachL = 0.5 * (SplitMach + std::fabs(SplitMach));
    SplitMachR = 0.5 * (SplitMach - std::fabs(SplitMach));

    // CellFlux[Tidx(DENS, i)] = SplitA * (SplitMachL * RhoL + SplitMachR *
    // RhoR); CellFlux[Tidx(VELX, i)] =
    //     SplitA * (SplitMachL * RhoL * UL + SplitMachR * RhoR * UR) +
    //     SplitPres(MachL, PLUS) * PL + SplitPres(MachR, MINUS) * PR;
    // CellFlux[Tidx(PRES, i)] =
    //     SplitA * (SplitMachL * RhoL * HL + SplitMachR * RhoR * HR);
    //
    //     Observe... The dumb Idea, but I've exausted all others
    // RhoL = Prims[Tidx(DENS, i)];
    // RhoR = Prims[Tidx(DENS, i + 1)];

    // UL = Prims[Tidx(VELX, i)];
    // UR = Prims[Tidx(VELX, i + 1)];
    // PL = Prims[Tidx(PRES, i)];
    // PR = Prims[Tidx(PRES, i + 1)];

    // aL2 = GAMMA * PL / RhoL;
    // aR2 = GAMMA * PR / RhoR;

    // HL = aL2 / (GAMMA - 1.0) + 0.5 * UL * UL;
    // HR = aR2 / (GAMMA - 1.0) + 0.5 * UR * UR;

    CellFlux[Tidx(DENS, i)] = SplitA * (SplitMachL * RhoL + SplitMachR * RhoR);
    CellFlux[Tidx(VELX, i)] =
        SplitA * (SplitMachL * RhoL * UL + SplitMachR * RhoR * UR);
    // + SplitPres(MachL, PLUS) * PL + SplitPres(MachR, MINUS) * PR;
    CellFlux[Tidx(PRES, i)] =
        SplitA * (SplitMachL * RhoL * HL + SplitMachR * RhoR * HR);

    std::cout << CellFlux[Tidx(DENS, i)] << " " << Prims[Tidx(DENS, i)] << " "
              << i << std::endl;
  }
};

#undef PLUS
#undef MINUS
